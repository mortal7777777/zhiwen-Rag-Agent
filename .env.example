# docker compose 环境变量（复制为 .env 后填写）

# ===== 必填 =====
# 对话模型 API Key（OpenAI 兼容接口；DeepSeek / 其他供应商均可）
DEEPSEEK_API_KEY=

# ===== 可选：视觉模型（识图/OCR）=====
SENSENOVA_API_KEY=

# ===== 可选：文档解析（PDF 混合解析 / PP-StructureV3 OCR Worker）=====
# auto=按 PDF 画像路由；pymupdf=只用原生文本层；paddle=复杂文档全走 Worker。
# Docker 镜像不含 Paddle/Worker，compose 默认 pymupdf；本机源码运行可用 auto。
# PDF_PARSE_BACKEND=pymupdf
# Worker 地址与参数（设置页「文档解析」也可调；保存后客户端会让预启动实例按新参数重启）
# PADDLE_OCR_URL=http://127.0.0.1:8090
# PADDLE_OCR_DEVICE=cpu
# PADDLE_OCR_LAZY_START=1
# PADDLE_OCR_IDLE_TIMEOUT_S=600
# PADDLE_OCR_PAGES_PER_PROCESS=300
# PADDLE_OCR_DPI=200
# PADDLE_OCR_TIMEOUT=120
# PADDLE_OCR_MAX_IMAGE_OCR=6
# PADDLE_OCR_VLM_FALLBACK=0
# 可选共享令牌：Worker 与后端需一致，留空=不鉴权（仅本机 127.0.0.1 可访问）
# PADDLE_OCR_TOKEN=

# ===== lite 模式：嵌入/重排 API（SiliconFlow 等 OpenAI 兼容供应商）=====
# 留空也可运行：索引/检索会失败，只有对话可用。推荐注册 SiliconFlow 免费档
# （bge-m3 嵌入 + bge-reranker-v2-m3 重排均有免费额度）。
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3
RERANKER_API_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_API_MODEL=BAAI/bge-reranker-v2-m3

# ===== 可选：MySQL 根密码（首次启动自动建库建表）=====
MYSQL_ROOT_PASSWORD=ragassistant123

# ===== 可选：pip 镜像源（国内加速）=====
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ===== 上下文窗口（按模型真实能力设置）=====
# 仅影响本地历史预算推断，不改发给 API 的请求。
# OpenCode Go 的 deepseek-v4.1-flash 为 1M；其他模型请按实际窗口改。
MODEL_CONTEXT_WINDOW=1000000
# 输出 + 静态提示/工具定义/D 块预留
CONTEXT_WINDOW_RESERVE=64000
# 用量面板成本估算的 USD→CNY 汇率
USD_CNY_RATE=7.2

# ===== 可选：系统提示词版本化 =====
# 1 = 会话首次运行时锁定模板/片段版本（默认）；0 = 回滚到旧的“每轮现读模板”语义
PROMPT_VERSIONING_ENABLED=1
# 可选：设置后所有 /api/prompts/* 与 /api/templates/* 请求需带 X-Prompt-Admin-Token
# 前端在「提示词」页右上角「令牌」保存；留空=不启用鉴权
# PROMPT_ADMIN_TOKEN=
# 全局 API Token（强烈建议对外/局域网部署时设置）：设置后所有 /api/* 请求
# 需携带 Authorization: Bearer <token>（存活/就绪探针除外）。前端首次收到 401
# 会弹窗要求输入并保存；CLI 需 export 同名环境变量。留空=完全无认证（仅限本机）。
# ZHIWEN_API_TOKEN=
# 对外部署建议设为 0：关闭 /docs、/redoc 与 /openapi.json（默认 1 便于演示）
# EXPOSE_DOCS=1
# 结构化日志：1 = 每行 JSON（含 ts/level/logger/request_id）；默认 0 = 文本
# LOG_JSON=0

# ===== 可选：宿主端口 =====
# 仅前端经 nginx 暴露；OpenSearch/MySQL/后端/SearXNG 均只走容器内网，不占宿主端口。
# 本机 5173 被本地 dev server 占用时改这里：
# FRONTEND_PORT=5174

# ===== 可选：命令执行 shell（本机工具）=====
# auto=优先 Git Bash，绝不静默选 WSL；可显式设 gitbash | wsl | default
# 显式用 WSL 时命令需使用 /mnt/c/... 路径（与宿主 Windows 路径不是同一套）
# COMMAND_SHELL=auto

# ===== 可选:联网搜索 =====
# 默认 duckduckgo(免 key);用 compose 自带的 SearXNG 时设 provider=searxng
# WEB_SEARCH_PROVIDER=searxng
# 国内网络:让 SearXNG 容器走宿主机 Clash 代理(host.docker.internal 在 Docker Desktop 可用)
# SEARXNG_PROXY=http://host.docker.internal:7890
