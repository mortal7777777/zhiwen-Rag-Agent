# docker compose 环境变量（复制为 .env 后填写）

# ===== 必填 =====
# 对话模型 API Key（OpenAI 兼容接口；DeepSeek / 其他供应商均可）
DEEPSEEK_API_KEY=

# ===== 可选：视觉模型（识图/OCR）=====
SENSENOVA_API_KEY=

# ===== lite 模式：嵌入/重排 API（SiliconFlow 等 OpenAI 兼容供应商）=====
# 留空也可运行：索引/检索会失败，只有对话可用。推荐注册 SiliconFlow 免费档
# （bge-m3 嵌入 + bge-reranker-v2-m3 重排均有免费额度）。
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3
RERANKER_API_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_API_MODEL=BAAI/bge-reranker-v2-m3

# ===== 可选：MySQL 根密码（首次启动自动建库建表）=====
MYSQL_ROOT_PASSWORD=ragassistant123

# ===== 可选：镜像构建模式 lite|full（full 需要本地模型目录，见 docker-compose.full.yml）=====
PROFILE=lite

# ===== 可选：pip 镜像源（国内加速）=====
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ===== 可选：宿主端口（本机 3306/9200 被占用时改这里）=====
# MYSQL_PORT=3307
# OPENSEARCH_PORT=9201
# BACKEND_PORT=8001
# FRONTEND_PORT=5174
# SEARXNG_PORT=8889

# ===== 可选:联网搜索 =====
# 默认 duckduckgo(免 key);用 compose 自带的 SearXNG 时设 provider=searxng
# WEB_SEARCH_PROVIDER=searxng
# 国内网络:让 SearXNG 容器走宿主机 Clash 代理(host.docker.internal 在 Docker Desktop 可用)
# SEARXNG_PROXY=http://host.docker.internal:7890
