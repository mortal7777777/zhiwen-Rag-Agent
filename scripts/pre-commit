#!/bin/sh
# 提交前自动运行后端测试；失败则阻止提交。
# 安装：scripts/install-git-hooks.ps1

PYTHON="D:/conda_envs/pytorch_env/python.exe"

if [ ! -f "$PYTHON" ]; then
  echo "未找到 $PYTHON，跳过测试钩子" >&2
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

"$PYTHON" -m pytest backend/tests -q
if [ $? -ne 0 ]; then
  echo "" >&2
  echo "pytest 失败，提交已阻止。确实要跳过请用：git commit --no-verify" >&2
  exit 1
fi
exit 0
